<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    User Registor
    <form method="post" action="/user-registor">
        enter email : <input type="email" name="email" id="">
        <% if(Error && Error.find(e=> e.path === "email")) {%>
                <%= Error.find(e=> e.path === "email").msg %>
            <% }%>
        <br/>


        enter password : <input type="text" name="password" id=""><br/>
        <input type="submit" value="Submit">
    </form>
    <div>
        <% if(Error && Error.find(e=> e.path==="password")) {%>
                <% Error.find(e=> e.path === "password").msg %>
            <%} %>
    </div>
</body>
</html>