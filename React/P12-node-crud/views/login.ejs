<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    Login:
    <form action="/login" method="post">
        rollno : <input type="text" name="rollno" id=""><br/>
        name : <input type="text" name="name" id=""><br/>
        <input type="submit" value="Submit">     
    </form>
    <div>
        Error:
        <% if(errorData && errorData.find(e=> e.path ==="rollno")) {%>
            <%= errorData.find(e=> e.path === "rollno").msg %>
            <% } %>
    </div>
</body>
</html>